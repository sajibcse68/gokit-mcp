{
  "name": "police-dashboard",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "vite build && vite build --config vite.company.config.ts",
    "start": "tsx server/index.ts",
    "start:http": "PORT=3001 tsx server/index.ts",
    "dev": "concurrently -k -n build,build-company,server \"vite build --watch\" \"vite build --watch --config vite.company.config.ts\" \"tsx watch server/index.ts\"",
    "dev:http": "concurrently -k -n build,build-company,server \"vite build --watch\" \"vite build --watch --config vite.company.config.ts\" \"PORT=3001 tsx watch server/index.ts\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.view.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.4",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vite-plugin-singlefile": "^2.3.3"
  }
